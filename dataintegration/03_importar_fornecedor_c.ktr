  <step>
    <name>2. Normalizar e validar</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compatible>N</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Limpeza e regras</jsScript_name>
        <jsScript_script>// Cada execução trata uma linha do CSV. Os campos originais são preservados.
function texto(v) { return v == null ? "" : String(v).replace(/^\s+|\s+$/g, ""); }
var fornecedor_id = "FORN_C";
// Neste catálogo fictício, espaços e hífen não distinguem referências.
var referencia_normalizada = texto(referencia).toUpperCase().replace(/[\s-]+/g, "");
var designacao_normalizada = texto(designacao).replace(/\s+/g, " ");
var p = texto(preco);
var q = texto(quantidade);
var motivos = [];
if (!/^[A-Z]{3}[0-9]{3}$/.test(referencia_normalizada)) motivos.push("Referencia obrigatoria no formato AAA999");
if (designacao_normalizada.length == 0) motivos.push("Designacao obrigatoria");
// Aceita vírgula ou ponto decimal, no máximo duas casas e sem milhares.
var preco_eur = null;
if (!/^[0-9]+([.,][0-9]{1,2})?$/.test(p)) motivos.push("Preco invalido: usar numero positivo com ate 2 casas decimais");
else {
 preco_eur = Number(p.replace(",", "."));
 if (preco_eur &lt;= 0) motivos.push("Preco deve ser superior a zero");
}
var quantidade_disponivel = null;
if (!/^[0-9]+$/.test(q) || Number(q) > 2147483647) motivos.push("Quantidade deve ser um inteiro entre 0 e 2147483647");
else quantidade_disponivel = Number(q);
var valido = motivos.length == 0;
var motivo_rejeicao = motivos.join("; ");
</jsScript_script>
      </jsScript>
    </jsScripts>
