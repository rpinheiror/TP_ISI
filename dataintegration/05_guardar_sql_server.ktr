  <attributes />
  <step>
    <name>1. Ler catalogo consolidado CSV</name>
    <type>CsvInput</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <filename>${Internal.Transformation.Filename.Directory}/../dados/saida/catalogo_consolidado.csv</filename>
    <filename_field />
    <rownum_field />
    <include_filename>N</include_filename>
    <separator>;</separator>
    <enclosure>"</enclosure>
    <header>Y</header>
    <buffer_size>50000</buffer_size>
    <lazy_conversion>N</lazy_conversion>
    <add_filename_result>Y</add_filename_result>
    <parallel>N</parallel>
    <newline_possible>Y</newline_possible>
    <format>mixed</format>
    <encoding>UTF-8</encoding>
    <fields>
      <field>
        <name>produto_id</name>
        <type>String</type>
        <format />
        <decimal />
        <group />
        <currency />
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>fornecedor_id</name>
        <type>String</type>
        <format />
        <decimal />
        <group />
        <currency />
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>referencia_normalizada</name>
        <type>String</type>
        <format />
        <decimal />
        <group />
        <currency />
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>designacao_normalizada</name>
        <type>String</type>
        <format />
        <decimal />
        <group />
        <currency />
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>preco_eur</name>
        <type>Number</type>
        <format>0.00</format>
        <decimal>.</decimal>
        <group />
        <currency />
        <length>-1</length>
        <precision>2</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>quantidade_disponivel</name>
        <type>Integer</type>
        <format />
        <decimal />
        <group />
        <currency />
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
    </fields>
    <attributes />
    <cluster_schema />
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>100</xloc>
      <yloc>240</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>2. Ler fornecedores da BD</name>
    <type>TableInput</type>
    <description />
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>350</xloc>
      <yloc>80</yloc>
      <draw>Y</draw>
    </GUI>
    <connection>SQLServer_TP1</connection>
    <sql>SELECT fornecedor_id AS fornecedor_chave, codigo AS fornecedor_codigo FROM dbo.Fornecedores</sql>
    <limit>0</limit>
    <lookup />
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
  </step>
  <step>
    <name>3. Obter ID numerico do fornecedor</name>
    <type>StreamLookup</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <from>2. Ler fornecedores da BD</from>
    <input_sorted>N</input_sorted>
    <preserve_memory>Y</preserve_memory>
    <sorted_list>N</sorted_list>
    <integer_pair>N</integer_pair>
    <lookup>
      <key>
        <name>fornecedor_id</name>
        <field>fornecedor_codigo</field>
      </key>
      <value>
        <name>fornecedor_chave</name>
        <rename>fornecedor_chave</rename>
        <default />
        <type>Integer</type>
      </value>
    </lookup>
    <attributes />
    <cluster_schema />
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>350</xloc>
      <yloc>240</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>4. Preparar campos da oferta</name>
    <type>SelectValues</type>
    <description />
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>650</xloc>
      <yloc>240</yloc>
      <draw>Y</draw>
    </GUI>
    <fields>
      <field>
        <name>produto_id</name>
        <rename />
      </field>
      <field>
        <name>fornecedor_chave</name>
        <rename>fornecedor_id</rename>
      </field>
      <field>
        <name>referencia_normalizada</name>
        <rename />
      </field>
      <field>
        <name>designacao_normalizada</name>
        <rename />
      </field>
      <field>
        <name>preco_eur</name>
        <rename />
      </field>
      <field>
        <name>quantidade_disponivel</name>
        <rename />
      </field>
      <select_unspecified>N</select_unspecified>
    </fields>
  </step>
  <step>
    <name>5. Inserir ou atualizar ofertas</name>
    <type>InsertUpdate</type>
    <description />
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>930</xloc>
      <yloc>240</yloc>
      <draw>Y</draw>
    </GUI>
    <connection>SQLServer_TP1</connection>
    <commit>1000</commit>
    <update_bypassed>N</update_bypassed>
    <lookup>
      <schema>dbo</schema>
      <table>Ofertas</table>
      <key>
        <name>fornecedor_id</name>
        <field>fornecedor_id</field>
        <condition>=</condition>
        <name2 />
      </key>
      <key>
        <name>referencia_normalizada</name>
        <field>referencia_normalizada</field>
        <condition>=</condition>
        <name2 />
      </key>
      <value>
        <name>produto_id</name>
        <rename>produto_id</rename>
        <update>Y</update>
      </value>
      <value>
        <name>fornecedor_id</name>
        <rename>fornecedor_id</rename>
        <update>N</update>
      </value>
      <value>
        <name>referencia_normalizada</name>
        <rename>referencia_normalizada</rename>
        <update>N</update>
      </value>
      <value>
        <name>designacao_normalizada</name>
        <rename>designacao_normalizada</rename>
        <update>Y</update>
      </value>
      <value>
        <name>preco_eur</name>
        <rename>preco_eur</rename>
        <update>Y</update>
      </value>
      <value>
        <name>quantidade_disponivel</name>
        <rename>quantidade_disponivel</rename>
        <update>Y</update>
      </value>
    </lookup>
  </step>
</transformation>