  <connection>
    <name>SQLServer_TP1</name>
    <server />
    <type>GENERIC</type>
    <access>Native</access>
    <database />
    <port>-1</port>
    <username />
    <password />
    <attributes>
      <attribute>
        <code>CUSTOM_DRIVER_CLASS</code>
        <attribute>com.microsoft.sqlserver.jdbc.SQLServerDriver</attribute>
      </attribute>
      <attribute>
        <code>CUSTOM_URL</code>
        <attribute>jdbc:sqlserver://${SQL_HOST}:${SQL_PORT};databaseName=${SQL_DATABASE};integratedSecurity=true;encrypt=true;trustServerCertificate=true;loginTimeout=8;</attribute>
      </attribute>
    </attributes>
  </connection>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>1. Ler catalogo consolidado CSV</from>
      <to>3. Obter ID numerico do fornecedor</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>2. Ler fornecedores da BD</from>
      <to>3. Obter ID numerico do fornecedor</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>3. Obter ID numerico do fornecedor</from>
      <to>4. Preparar campos da oferta</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>4. Preparar campos da oferta</from>
      <to>5. Inserir ou atualizar ofertas</to>
      <enabled>Y</enabled>
    </hop>
  </order>
